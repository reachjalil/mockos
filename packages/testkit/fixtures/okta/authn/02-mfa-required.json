{
  "name": "okta-authn-mfa-required",
  "description": "A user whose mock policy requires an enrolled factor enters MFA_REQUIRED after the password is verified.",
  "provider": "okta",
  "area": "authn",
  "request": {
    "method": "POST",
    "path": "/api/v1/authn",
    "headers": { "content-type": "application/json" },
    "body": {
      "username": "mfa.authn@example.test",
      "password": "SyntheticPassw0rd!"
    }
  },
  "expected": {
    "status": 200,
    "headers": { "cache-control": "no-store" },
    "bodyContains": {
      "status": "MFA_REQUIRED",
      "_embedded": {
        "user": {
          "profile": { "login": "mfa.authn@example.test" }
        },
        "factor": [
          {
            "factorType": "token:software:totp",
            "provider": "OKTA",
            "profile": {},
            "_links": {
              "verify": {
                "hints": {
                  "allow": ["POST"]
                }
              }
            }
          }
        ]
      },
      "_links": {
        "cancel": {
          "hints": {
            "allow": ["POST"]
          }
        }
      }
    }
  },
  "provenance": "official-docs",
  "sourceUrl": "https://developer.okta.com/docs/reference/api/authn/#response-example-for-primary-authentication-with-public-application-factor-challenge",
  "lastVerified": "2026-07-26",
  "status": "implemented",
  "notes": "A state token and exact verification/cancel hrefs are returned but omitted from the stable subset because they contain generated bearer or identity-bound values. Focused adapter and Worker tests assert that every emitted action resolves to its mounted public route."
}
